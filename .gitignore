# the original game (your own copy; see README) and everything derived from it
/game
/ida/
/dump/
/Video/
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
/IDA_ILB_Extraced.c
/draft/ILB_raw*.c
/draft/ILB_try.c
/draft/*.err
# draft/build: only the generated game code that the build compiles is kept; everything else there is
# build output, run folders, saves, recordings and Wine prefixes
/draft/build/*
!/draft/build/src/
/draft/build/src/*.uninit
!/draft/build/ILB_defs.h
!/draft/build/ILB_draft_decls.h
!/draft/build/ILB_draft_types.h
!/draft/build/ILB_image.bin
!/draft/build/native/
/draft/build/native/*
!/draft/build/native/generated_stubs.c
# ... and the plain (non-holiday) vendor sheet, taken from a 2020 release that can no longer be downloaded;
# the holiday sheets are rebuilt from current releases by tools/make_season_npcs.py
!/draft/build/native/run/
/draft/build/native/run/*
!/draft/build/native/run/mods/
/draft/build/native/run/mods/*
!/draft/build/native/run/mods/npcs_plain.raw

# build output, and settings a run from this folder leaves behind
/native_appdata/
*.o
*.obj
/build/
/server/target/
__pycache__/
*.log

# the game's data file: never in the repository, wherever a copy of it lies
*.gbp
