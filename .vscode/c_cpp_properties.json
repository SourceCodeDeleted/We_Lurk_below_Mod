{
    "version": 4,
    "configurations": [
        {
            "name": "ILB (as tools/check_src.sh compiles src/)",
            "compilerPath": "/usr/bin/clang++",
            "compilerArgs": [ "-target", "i686-pc-windows-msvc", "-fms-extensions", "-nostdinc", "-nostdinc++" ],
            "intelliSenseMode": "windows-clang-x86",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/tools/stub_include/crt",
                "${workspaceFolder}/tools/stub_include/platform"
            ],
            "defines": [ "_WIN32", "_M_IX86" ]
        }
    ]
}
